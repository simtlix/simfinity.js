{
  "name": "@simtlix/simfinity-js",
  "version": "1.2.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint '**/*.js'",
    "lint-fix": "eslint --fix '**/*.js'"
  },
  "author": "Simtlix",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/simtlix/simfinity.git"
  },
  "peerDependencies": {
    "graphql": "^14.7.0",
    "mongoose": "^8.15.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "ghooks": "^2.0.4",
    "globals": "^16.3.0",
    "jest": "^29.0.0"
  },
  "config": {
    "ghooks": {
      "pre-commit": "npm run lint || npm run lint-fix"
    },
    "owner": "simtlix"
  },
  "optionalDependencies": {
    "graphql": "^14.7.0",
    "mongoose": "^8.15.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ]
  }
}
