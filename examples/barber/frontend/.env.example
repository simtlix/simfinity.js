# MongoDB Compose defaults; use API 4500 / frontend 4501 for PostgreSQL.
# NEXT_PUBLIC_GRAPHQL_URL is embedded at build time and must be browser-reachable.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4400/graphql

# Set these in the shell when running Playwright (it does not load .env.local).
GRAPHQL_ENDPOINT=http://localhost:4400/graphql
PLAYWRIGHT_BASE_URL=http://localhost:4401
DEMO_SHOP_SLUG=barber-demo
