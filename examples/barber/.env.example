# Synthetic, loopback-only examples; replace secrets before deploying publicly.
BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=localhost
MONGODB_PORT=57417
MONGODB_BACKEND_PORT=4400
MONGODB_FRONTEND_PORT=4401
POSTGRES_PORT=55441
POSTGRES_BACKEND_PORT=4500
POSTGRES_FRONTEND_PORT=4501
POSTGRES_PASSWORD=barber_local
JWT_SECRET=example-barber-access-secret
JWT_REFRESH_SECRET=example-barber-refresh-secret
# Requests per minute, passed to the backend by both Compose files: GraphQL and MCP per client IP;
# uploads per client IP before authentication, then per account. Raise them for repeated contract runs.
GRAPHQL_RATE_LIMIT_MAX=300
MCP_RATE_LIMIT_MAX=300
UPLOAD_IP_RATE_LIMIT_MAX=100
UPLOAD_RATE_LIMIT_MAX=20

# Best-effort after-commit reminder log (no delivery provider).
REMINDER_JOBS_ENABLED=false
