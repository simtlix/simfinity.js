{
  "name": "@simtlix/simfinity-core",
  "version": "3.14.0",
  "description": "Driver-free GraphQL runtime and model metadata for Simfinity",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "auth": [
        "types/auth/index.d.ts"
      ],
      "auth/errors": [
        "types/auth/errors.d.ts"
      ],
      "auth/expressions": [
        "types/auth/expressions.d.ts"
      ],
      "auth/rules": [
        "types/auth/rules.d.ts"
      ],
      "plugins": [
        "types/plugins.d.ts"
      ],
      "scalars": [
        "types/scalars.d.ts"
      ],
      "validators": [
        "types/validators.d.ts"
      ],
      "introspection": [
        "types/introspection.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./auth": {
      "types": "./types/auth/index.d.ts",
      "default": "./src/auth/index.js"
    },
    "./auth/errors": {
      "types": "./types/auth/errors.d.ts",
      "default": "./src/auth/errors.js"
    },
    "./auth/expressions": {
      "types": "./types/auth/expressions.d.ts",
      "default": "./src/auth/expressions.js"
    },
    "./auth/rules": {
      "types": "./types/auth/rules.d.ts",
      "default": "./src/auth/rules.js"
    },
    "./internal/object-id": "./src/auth/object-id.js",
    "./internal/query-operators": "./src/query-operators.js",
    "./internal/record-version": "./src/record-version.js",
    "./internal/relation-storage": "./src/relation-storage.js",
    "./plugins": {
      "types": "./types/plugins.d.ts",
      "default": "./src/plugins.js"
    },
    "./scalars": {
      "types": "./types/scalars.d.ts",
      "default": "./src/scalars.js"
    },
    "./validators": {
      "types": "./types/validators.d.ts",
      "default": "./src/validators.js"
    },
    "./introspection": {
      "types": "./types/introspection.d.ts",
      "default": "./src/introspection-config.js"
    },
    "./internal/schema-registrations": "./src/schema-registrations.js",
    "./internal/errors": "./src/errors/simfinity.error.js"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/simtlix/simfinity.js",
    "directory": "packages/core"
  },
  "peerDependencies": {
    "graphql": "^16.11.0"
  },
  "keywords": [
    "simfinity",
    "graphql",
    "runtime",
    "schema",
    "crud",
    "nodejs"
  ]
}
